APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# v2 bildirim kuyrugu (v2:bildirim-isle). Varsayilan kapali: acilmadan hic mesaj gitmez.
BILDIRIM_ISLEYICI_AKTIF=false
BILDIRIM_KUYRUK_ADI=v2_bildirim
# FIREBASE_ANAHTAR_DIZINI=/yol/firebase
# Salon-bagimsiz sistem SMS'i (eski Controller::sms_gonder('', ...))
SMS_EFETECH_SISTEM_APIKEY=
SMS_EFETECH_SISTEM_BASLIK=RANDVMCEPTE
# Google Takvim belirteci tazeleme (eski panelle ayni OAuth istemcisi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# saat_boslugu_kampanya push'u. Kapali iken eski isleyici gibi hataya duser.
BILDIRIM_SAAT_BOSLUGU_PUSH_AKTIF=true
